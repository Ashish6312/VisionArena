# Copy to .env and adjust for your machine. Nothing here is a secret.
# Every value below is validated at startup by Pydantic Settings
# (app/config.py) — an invalid type fails loudly at boot with a clear
# error, not confusingly deep inside OpenCV/YOLO/MediaPipe later.

# Camera / video
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_FPS=30

# YOLO detection — accepts any Ultralytics model file.
# yolo26n.pt is the default here. Note: yolov8n.pt measured faster on this
# project's CPU-only benchmark hardware — yolo26n.pt is kept as the default
# regardless since Detector has zero model-generation-specific code and
# either drops in with no other change. Swap freely for your own hardware.
YOLO_MODEL=yolo26n.pt
YOLO_CONFIDENCE=0.4
YOLO_DEVICE=cpu

# MediaPipe gestures — .task model bundles, downloaded separately into
# data/models/ (see README "Quick start")
HAND_MODEL_PATH=data/models/hand_landmarker.task
POSE_MODEL_PATH=data/models/pose_landmarker_lite.task
GESTURE_MIN_CONFIDENCE=0.5

# CV/game loop decoupling — a VisionState older than this many seconds is
# reported as "stale" rather than silently reused as current.
VISION_STALE_SECONDS=1.5

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Persistence — SQLite by default, swap DATABASE_URL for Postgres later
DATABASE_URL=sqlite:///data/sessions/visionstrike.db

# Telemetry / replay — structured per-tick JSONL, not video.
# See scripts/replay_session.py.
TELEMETRY_DIR=data/sessions/telemetry

# Game loop rate — GameRunner's own tick rate, independent of CV's rate
# thanks to the CV/game-loop decoupling.
GAME_TICK_HZ=30

# Observability
LOG_LEVEL=INFO
